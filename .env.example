# Required for real model responses. Store the value in Vercel's environment
# variables or in .env.local during local development. Never commit it.
DEEPSEEK_API_KEY=sk-your-key

# Optional overrides.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Set to true to keep the local sample generator active in production.
# Leave unset when deploying with a real API key.
DEMO_MODE=false